# ==========================================
# Confluo Production Deployment Environment
# ==========================================

# -----------------
# Frontend (Vercel)
# -----------------
VITE_API_URL=https://your-backend-url.railway.app

# -----------------
# Backend (Railway / Render / VPS)
# -----------------
MONGODB_USERNAME=your_mongo_username
MONGODB_PASSWORD=your_mongo_password
JWT_SECRET=generate_a_secure_random_64_character_hex_or_base64_string
LIVEBLOCKS_SECRET_KEY=sk_prod_...

# URL where your Vercel frontend is deployed (no trailing slash)
APP_FRONTEND_URL=https://your-frontend.vercel.app

# URL where runner is deployed
APP_EXECUTION_SERVICE_URL=https://your-runner-url.railway.app
APP_EXECUTION_SERVICE_TOKEN=generate_random_secret_token_here

# OAuth Providers (Redirect URI: {BACKEND_URL}/login/oauth2/code/{google|github})
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Git Storage Path (optional, defaults to data/git-storage)
GIT_STORAGE_BASE_PATH=data/git-storage

# -----------------
# Runner (Railway / Render / VPS)
# -----------------
PORT=4000
E2B_API_KEY=e2b_...
RUNNER_AUTH_TOKEN=same_token_as_APP_EXECUTION_SERVICE_TOKEN


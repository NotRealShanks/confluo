# Spring Boot Backend Environment Configuration Template

# MongoDB Connection
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_min_256_bits_here

# Liveblocks Integration
LIVEBLOCKS_SECRET_KEY=your_liveblocks_secret_key_here

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# E2B Runner Service Integration
APP_EXECUTION_SERVICE_URL=http://localhost:4000
# Must match RUNNER_TOKEN configured in the runner service
APP_EXECUTION_SERVICE_TOKEN=your_strong_internal_runner_secret_here


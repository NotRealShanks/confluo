# Spring Boot Backend Environment Configuration Template

# MongoDB Connection
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password

# JWT Secret & Expiry
JWT_SECRET=replace_with_your_jwt_secret_key_min_256_bits_here

# Liveblocks Integration
LIVEBLOCKS_SECRET_KEY=replace_with_your_liveblocks_secret_key_here

# OAuth Providers
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret
GITHUB_CLIENT_ID=replace_with_your_github_client_id
GITHUB_CLIENT_SECRET=replace_with_your_github_client_secret

# E2B Runner Service Integration
APP_EXECUTION_SERVICE_URL=http://localhost:4000
# Shared internal secret for backend-to-runner authentication.
# Mandatory: minimum 32 characters required.
# MUST exactly match RUNNER_TOKEN configured in the runner service.
APP_EXECUTION_SERVICE_TOKEN=replace_with_at_least_32_char_shared_secret

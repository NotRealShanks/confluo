# E2B Sandbox API Key (get free key from https://e2b.dev)
E2B_API_KEY=your_e2b_api_key_here

# Runner Port (default: 4000)
PORT=4000

# Service-to-service authentication secret shared between backend and runner.
# Mandatory in production (minimum 16 characters required).
RUNNER_TOKEN=your_strong_internal_runner_secret_here

# Runtime environment (development | production | test)
NODE_ENV=development

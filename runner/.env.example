# E2B Sandbox API Key (obtain from https://e2b.dev)
E2B_API_KEY=replace_with_your_e2b_api_key

# Runner Network Binding
HOST=127.0.0.1
PORT=4000

# Shared internal secret for backend-to-runner authentication.
# Mandatory in ALL environments (minimum 32 characters required).
# MUST exactly match APP_EXECUTION_SERVICE_TOKEN in backend configuration.
RUNNER_TOKEN=replace_with_at_least_32_char_shared_secret

# Runtime environment (development | production | test)
NODE_ENV=development
